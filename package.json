{
  "name": "audit-analytics-viewer",
  "private": true,
  "version": "0.2.0",
  "description": "Audit Analytics Viewer — restitution web et artefact autonome des audits analytics JAKALA (contrat audit.json 1.1)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
