  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "pptxgenjs": "3.12.0"
  }
}
